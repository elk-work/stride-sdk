{
  "name": "@elk-work/stride-sdk",
  "version": "0.2.0",
  "description": "Stride observation emitter for Cloudflare Workers, Node, and any fetch-capable runtime",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elk-work/stride-sdk.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/elk-work/stride-sdk#readme",
  "bugs": {
    "url": "https://github.com/elk-work/stride-sdk/issues"
  },
  "keywords": [
    "observability",
    "telemetry",
    "tracing",
    "cloudflare-workers",
    "stride"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
